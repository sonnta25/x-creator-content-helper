{
  "manifest_version": 3,
  "name": "X Content Bot Bridge",
  "version": "0.9.0",
  "description": "Runs scheduled reply discovery and manual follow-candidate workflows.",
  "permissions": ["storage", "tabs", "scripting", "alarms", "activeTab"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "https://gemini.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "X Content Bot Bridge"
  },
  "background": {
    "service_worker": "background.js"
  }
}
