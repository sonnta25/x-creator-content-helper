TELEGRAM_BOT_TOKEN=123456:replace_me

# Optional. Send /automationhere in Telegram to save this automatically.
# Scheduled /replytargets and /tweettrend3 approvals are sent to this chat.
TELEGRAM_APPROVAL_CHAT_ID=
# Optional Telegram override for the scheduled /replytargets interval. The same
# value is the hard maximum age of posts accepted by that workflow.
# Set this with /replyevery <minutes>; minimum 5.
TELEGRAM_REPLY_TARGETS_MINUTES=
# Internal schedule revision written by /replyevery. Leave blank initially.
TELEGRAM_REPLY_TARGETS_UPDATED_AT=
AUTOMATION_APPROVALS_PATH=data/automation_approvals.json

# /download fetches one public video and sends it back as a Telegram document.
# The public Telegram Bot API accepts files up to about 50 MB, so 45 MB leaves
# headroom. Only raise this when using a local Bot API server with a higher limit.
DOWNLOAD_MAX_FILE_MB=45
DOWNLOAD_TIMEOUT_SECONDS=180
# Optional Netscape-format cookie file for videos that require a logged-in session.
DOWNLOAD_COOKIES_FILE=
# Optional automatic refresh from a browser profile. Leave blank to disable.
# Examples: chrome + Default, or chrome + Profile 1.
DOWNLOAD_COOKIES_FROM_BROWSER=
DOWNLOAD_BROWSER_PROFILE=

# Text/content provider. Gemini produces the final result in one browser job.
CONTENT_PROVIDER=extension_bridge

# Chrome extension bridge mode. Use this when you have Gemini web access
# but no API keys. Load browser_extension/ as an unpacked Chrome extension.
EXTENSION_BRIDGE_HOST=127.0.0.1
EXTENSION_BRIDGE_PORT=8765
EXTENSION_BRIDGE_TOKEN=local-bridge-change-me
EXTENSION_BRIDGE_TIMEOUT_SECONDS=360

# Image prompt prefix used for Gemini image jobs through the extension.
GEMINI_IMAGE_PROMPT_PREFIX=Create one square realistic image for this social post. Return the image only, with no extra text.

# Image generation is optional and costs one extra Gemini browser job per image.
# Keep it off on a small VPS; set true only when images are needed.
GENERATE_IMAGES=false
IMAGE_PROVIDER=extension_bridge

# Optional live X search through twscrape. No official X API key is required,
# but an authorized x.com session cookie is required.
# Copy auth_token and ct0 from browser DevTools > Application > Cookies on x.com.
X_COOKIE=
X_ACCOUNT_NAME=telegram_bot
X_ACCOUNTS_DB=data/twscrape_accounts.db
X_SEARCH_LIMIT=8
X_SEARCH_PRODUCT=Top

# /replytargets focuses on broad high-reach conversations, independently of CREATOR_NICHE.
# Candidates must come from accounts at or above this follower count. When X exposes
# post views, the post must also meet REPLY_TARGET_MIN_VIEWS.
REPLY_TARGET_MIN_AUTHOR_FOLLOWERS=50000
REPLY_TARGET_MIN_VIEWS=500

# Long-form post limit for /tweet, /tweetx, /tweettrend3, /dailybrief, and /retweet.
# Replies stay short separately.
X_POST_CHAR_LIMIT=2000

# Trend discovery for /tweettrend3 and /dailybrief.
# Sources: x, google_trends, rss. RSS includes built-in Google News feeds.
# Add custom feeds with semicolon-separated entries: Label|https://example.com/feed.xml
TREND_SOURCES=x,google_trends,rss
GOOGLE_TRENDS_GEO=US
TREND_RSS_URLS=

# Hashtag mode: none, auto, or one.
HASHTAG_MODE=auto

# Creator positioning for niche-led original content such as /tweettrend3.
# /replytargets deliberately follows broad high-reach conversations instead.
CREATOR_NICHE=gold markets, cryptocurrency, and practical AI tools such as ChatGPT, Claude, Grok, and emerging AI products
CREATOR_VOICE=witty, practical, dry, slightly contrarian, with a sharp creator POV
TARGET_AUDIENCE=Vietnamese retail investors, crypto users, creators, founders, and professionals seeking timely practical insights on gold, crypto, and AI tools
