TELEGRAM_BOT_TOKEN=123456:replace_me

# Optional. Scheduled /replytargets approvals are sent to this chat.
TELEGRAM_APPROVAL_CHAT_ID=
# Optional Telegram override for the scheduled /replytargets scan interval.
# Set this with /replyevery <minutes>; minimum 5. This no longer controls post age.
TELEGRAM_REPLY_TARGETS_MINUTES=
# Internal schedule revision written by /replyevery. Leave blank initially.
TELEGRAM_REPLY_TARGETS_UPDATED_AT=
# Optional /replyvideo schedule override. Set with /videoevery; default in the
# Chrome extension is 5 minutes. The revision is maintained by the bot.
TELEGRAM_REPLY_VIDEO_MINUTES=
TELEGRAM_REPLY_VIDEO_UPDATED_AT=
AUTOMATION_APPROVALS_PATH=data/automation_approvals.json

# /download fetches public post media (images, carousels, videos, or Reels)
# and sends the original files back as Telegram documents.
# The public Telegram Bot API accepts files up to about 50 MB, so 45 MB leaves
# headroom. Only raise this when using a local Bot API server with a higher limit.
DOWNLOAD_MAX_FILE_MB=45
DOWNLOAD_TIMEOUT_SECONDS=180
# Optional Netscape-format cookie file for videos that require a logged-in session.
DOWNLOAD_COOKIES_FILE=
# Optional automatic refresh from a browser profile. Leave blank to disable.
# Examples: chrome + Default, or chrome + Profile 1.
DOWNLOAD_COOKIES_FROM_BROWSER=
DOWNLOAD_BROWSER_PROFILE=

# Text/content provider. Gemini produces the final result in one browser job.
CONTENT_PROVIDER=extension_bridge

# Chrome extension bridge mode. Use this when you have Gemini web access
# but no API keys. Load browser_extension/ as an unpacked Chrome extension.
EXTENSION_BRIDGE_HOST=127.0.0.1
EXTENSION_BRIDGE_PORT=8765
EXTENSION_BRIDGE_TOKEN=local-bridge-change-me
EXTENSION_BRIDGE_TIMEOUT_SECONDS=360

# Optional live X search through twscrape. No official X API key is required,
# but an authorized x.com session cookie is required.
# Copy auth_token and ct0 from browser DevTools > Application > Cookies on x.com.
X_COOKIE=
X_ACCOUNT_NAME=telegram_bot
# Real X username used to find replies that you manually publish after approval.
# This is different from X_ACCOUNT_NAME, which is only twscrape's local cookie label.
# You can also set this in Telegram with /replylearn username @yourname.
X_OWNER_USERNAME=
X_ACCOUNTS_DB=data/twscrape_accounts.db
X_SEARCH_LIMIT=8
X_SEARCH_PRODUCT=Top

# /replytargets starts broad; balanced/qualified modes also add a CREATOR_NICHE lane.
# This follower count is a capped reach preference, not a hard gate. Post-level
# momentum and audience breakout can outrank a larger but slower account. When X
# exposes post views, the post must still meet REPLY_TARGET_MIN_VIEWS.
REPLY_TARGET_MIN_AUTHOR_FOLLOWERS=50000
REPLY_TARGET_MIN_VIEWS=500
REPLY_TARGET_MAX_AGE_MINUTES=360
# Comma-separated X language codes, at most 6. Defaults to English + Japanese.
# No country filter is applied because most posts do not carry place metadata.
# Manage this safely from Telegram with /replylangs show|add|remove|set.
REPLY_TARGET_LANGUAGES=en,ja
# balanced blends reach, audience fit, and prior author response. Other choices:
# reach, qualified, relationship.
REPLY_TARGET_MODE=balanced
# qualify prioritizes reach, earn adds verified-audience and monetization-safety
# proxies, and network prioritizes author responses and repeat relationships.
# Change safely from Telegram with /replygoal.
CREATOR_GOAL=qualify
# First sightings are normally watched until a later scan confirms acceleration.
REPLY_WATCH_PATH=data/reply_watchlist.json
# Daily approval-card hard ceiling. This is not a posting quota: target-quality,
# deduplication, daily capacity, and manual final submission still apply.
CREATOR_DAILY_REPLY_CAP=500
# Guardrail against repeatedly targeting the same author. Both ceilings are
# configurable from Telegram with /replycap.
REPLY_AUTHOR_DAILY_CAP=5
# A guided /session defaults to this duration and queues at most five cards.
REPLY_SESSION_MINUTES=20
# Reply approval cards requested per run. Both values are clamped to 2-5.
REPLY_TARGET_BATCH_SIZE=3
REPLY_VIDEO_BATCH_SIZE=3
# Snapshot deltas include direct-reply velocity so crowded threads can be
# penalized separately from the post's viral momentum.
REPLY_TARGET_METRICS_PATH=data/reply_target_metrics.json
REVENUE_OPS_PATH=data/revenue_ops.json
# Stores manual payout/checklist inputs, author watchlist, risk mode, and pacing state.

# /replyvideo uses dedicated video lanes (global, English, Japanese, Vietnamese).
# It starts at these strict thresholds, then applies bounded warm/fill fallbacks
# when needed to build a batch of at least two distinct videos.
REPLY_VIDEO_MIN_VIEWS=15000
REPLY_VIDEO_MAX_AGE_MINUTES=45
# When caption and X media descriptions are unreliable, download the video,
# extract representative frames with the bundled imageio-ffmpeg binary, and
# upload them to Gemini. Disable only if the VPS cannot afford video downloads.
REPLY_VIDEO_FRAME_ANALYSIS=true
REPLY_VIDEO_FRAME_COUNT=2

# Automatic reply outcome tracking and bounded strategy learning are enabled by default.
# The bot discovers your posted replies from X, samples them at 15m/1h/6h/24h,
# and can change strategy-selection weights by no more than 10% per weekly revision.
# It never edits source code or the base prompt. /replylearn rollback restores the
# previous weight version.
REPLY_LEARNING_ENABLED=true
REPLY_LEARNING_PATH=data/reply_learning.json
# Metrics use their fixed checkpoints. Author responses use adaptive polling:
# every 5m in hour one, every 15m through hour six, then hourly.
REPLY_TRACKING_POLL_MINUTES=5
# Local-hour daily decision digest; sent only when tracked replies exist.
REPLY_DAILY_DIGEST_HOUR=22
# Release mobile-approved target locks that could not be matched after this window.
STALE_MOBILE_APPROVAL_HOURS=6
CREATOR_TIMEZONE=Asia/Ho_Chi_Minh

# Creator positioning used by reply prompts and persona settings.
# The persona shapes reply voice and the optional niche discovery lane.
CREATOR_NICHE=gold markets, cryptocurrency, and practical AI tools such as ChatGPT, Claude, Grok, and emerging AI products
CREATOR_VOICE=witty, practical, dry, slightly contrarian, with a sharp creator POV
TARGET_AUDIENCE=Vietnamese retail investors, crypto users, creators, founders, and professionals seeking timely practical insights on gold, crypto, and AI tools
